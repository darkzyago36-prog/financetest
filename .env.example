# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Configure com a Project URL (https://<project-ref>.supabase.co)
# e a chave pública (anon JWT ou sb_publishable_...) do seu projeto Supabase.
# NUNCA coloque chaves secretas (service_role ou sb_secret_...) no frontend.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY=""
